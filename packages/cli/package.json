{
  "name": "@metacoding/vsm-pi-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "User-facing CLI for VSM-Pi: the `regulator status` read model over a definition and an instance.",
  "bin": {
    "regulator-status": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@metacoding/vsm-pi-core": "workspace:*",
    "@metacoding/vsm-pi-protocol": "workspace:*"
  }
}
