{
  "name": "@metacoding.io/regulator-control-room",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "private": false,
  "description": "The maintainer's read-only control room: one page over the `regulator status` read model — definition topology, running instances, and what each unit is doing.",
  "homepage": "https://github.com/MetaCoding-io/regulator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MetaCoding-io/regulator.git",
    "directory": "packages/control-room"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "regulator-control-room": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@metacoding.io/regulator": "workspace:*",
    "@metacoding.io/regulator-core": "workspace:*",
    "@metacoding.io/regulator-protocol": "workspace:*"
  }
}
