{
  "name": "portfolio",
  "version": 1,
  "description": "Budgets and model routes for the portfolio workload. A close is small work and most of it is arithmetic: low ceilings, one attempt for the read-only types, three for the confirmation (the first is spent asking for consent), and the cheaper route for the review. The two program types are budgeted in wall-clock alone, with a second attempt in case the first is refused; their tokens and turns are zero by construction and the ceilings here are never reached. Ceilings are per attempt; attempts are per unit.",
  "budgets": {
    "default": {
      "tokens": 120000,
      "cost": 0.5,
      "wallClockMs": 600000,
      "turns": 30,
      "attempts": 3
    },
    "byUnitType": {
      "ingest-positions": {
        "tokens": 80000,
        "turns": 20,
        "attempts": 2
      },
      "propose-target": {
        "tokens": 80000,
        "turns": 20,
        "attempts": 2
      },
      "plan-rebalance": {
        "wallClockMs": 60000,
        "attempts": 2
      },
      "confirm-trades": {
        "tokens": 60000,
        "turns": 15,
        "attempts": 3
      },
      "harvest-losses": {
        "wallClockMs": 60000,
        "attempts": 2
      },
      "review": {
        "tokens": 60000,
        "turns": 12,
        "attempts": 1
      },
      "close-period": {
        "tokens": 30000,
        "turns": 6,
        "attempts": 1
      }
    }
  },
  "coordination": {
    "oscillationThreshold": 4
  },
  "models": {
    "default": {
      "primary": "anthropic/claude-sonnet-4-5",
      "fallback": [
        "openai/gpt-5"
      ]
    },
    "byUnitType": {
      "review": {
        "primary": "anthropic/claude-haiku-4-5",
        "fallback": [
          "openai/gpt-5-mini"
        ]
      },
      "close-period": {
        "primary": "anthropic/claude-haiku-4-5",
        "fallback": [
          "openai/gpt-5-mini"
        ]
      }
    }
  }
}
