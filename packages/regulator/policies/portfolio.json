{
  "name": "portfolio",
  "version": 1,
  "description": "Budgets and model routes for the portfolio workload. A close is small work and most of it is arithmetic: low ceilings, one attempt for the read-only types, three for the plan (the first is spent asking for consent), and the cheaper route for the review. Ceilings are per attempt; attempts are per unit.",
  "budgets": {
    "default": { "tokens": 120000, "cost": 0.5, "wallClockMs": 600000, "turns": 30, "attempts": 3 },
    "byUnitType": {
      "ingest-positions": { "tokens": 80000, "turns": 20, "attempts": 2 },
      "propose-target": { "tokens": 80000, "turns": 20, "attempts": 2 },
      "plan-rebalance": { "tokens": 100000, "turns": 25, "attempts": 3 },
      "review": { "tokens": 60000, "turns": 12, "attempts": 1 },
      "close-period": { "tokens": 30000, "turns": 6, "attempts": 1 }
    }
  },
  "coordination": { "oscillationThreshold": 4 },
  "models": {
    "default": { "primary": "anthropic/claude-sonnet-4-5", "fallback": ["openai/gpt-5"] },
    "byUnitType": {
      "review": { "primary": "anthropic/claude-haiku-4-5", "fallback": ["openai/gpt-5-mini"] },
      "close-period": { "primary": "anthropic/claude-haiku-4-5", "fallback": ["openai/gpt-5-mini"] }
    }
  }
}
