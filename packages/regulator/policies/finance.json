{
  "name": "finance",
  "version": 1,
  "description": "Budgets and model routes for the personal-finance workload. A close is small work: low ceilings, one attempt for the read-only types, and the cheaper route for categorization. Ceilings are per attempt; attempts are per unit.",
  "budgets": {
    "default": { "tokens": 120000, "cost": 0.5, "wallClockMs": 600000, "turns": 30, "attempts": 3 },
    "byUnitType": {
      "ingest": { "tokens": 80000, "turns": 20 },
      "categorize": { "tokens": 100000, "turns": 25 },
      "reconcile": { "tokens": 60000, "turns": 12, "attempts": 1 },
      "report": { "tokens": 80000, "turns": 20, "attempts": 2 },
      "prepare-payment": { "tokens": 60000, "turns": 15, "attempts": 2 },
      "close": { "tokens": 30000, "turns": 6, "attempts": 1 }
    }
  },
  "coordination": { "oscillationThreshold": 4 },
  "models": {
    "default": { "primary": "anthropic/claude-sonnet-4-5", "fallback": ["openai/gpt-5"] },
    "byUnitType": {
      "categorize": { "primary": "anthropic/claude-haiku-4-5", "fallback": ["openai/gpt-5-mini"] },
      "reconcile": { "primary": "anthropic/claude-haiku-4-5", "fallback": ["openai/gpt-5-mini"] },
      "close": { "primary": "anthropic/claude-haiku-4-5", "fallback": ["openai/gpt-5-mini"] }
    }
  }
}
