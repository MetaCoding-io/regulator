{
  "name": "@metacoding/regulator",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": false,
  "description": "regulator: a coding-agent harness on Pi with an explicit cybernetic control plane. The S3 loop (contract, dispatch, verify, route, close) with leases and budgets, host-run evidence at closeout, obligations owed to someone, an algedonic path to a person, and a registry of every regulator with its stated limitation. Installable as a Pi package and as the `regulator` CLI; the definition (registry, identity, profiles, policies, workloads, evals) ships beside the code.",
  "keywords": [
    "pi",
    "coding-agent",
    "agent-harness",
    "viable-system-model",
    "cybernetics",
    "control-plane",
    "regulator"
  ],
  "homepage": "https://github.com/MetaCoding-io/vsm-pi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MetaCoding-io/vsm-pi.git",
    "directory": "packages/regulator"
  },
  "bugs": "https://github.com/MetaCoding-io/vsm-pi/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "regulator": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "pi": {
    "extensions": [
      "./dist/cp2-typed-tools.js",
      "./dist/cp3-profiles.js",
      "./dist/cp4-coordination.js",
      "./dist/cp5-contract.js",
      "./dist/cp6-budget.js",
      "./dist/cp7-recovery.js",
      "./dist/cp8-evidence.js",
      "./dist/cp9-authority.js",
      "./dist/cp10-intelligence.js",
      "./dist/cp11-identity.js",
      "./dist/cp12-algedonic.js"
    ]
  },
  "files": [
    "dist",
    "!dist/*.test.*",
    "identity",
    "profiles",
    "policies",
    "workload",
    "registry",
    "evals",
    "contracts",
    "fixture",
    "fixture-finance",
    "fixture-injection",
    "fixture-oscillation",
    "drift",
    "settings.json",
    "BOUNDARY.md",
    "OPERATING.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/*.test.js",
    "fixture:test": "cd fixture && node --test",
    "cp0": "cd fixture && pi -e ../dist/cp0-event-log.js",
    "cp1": "cd fixture && pi -e ../dist/cp1-trace.js",
    "cp2": "cd fixture && pi -e ../dist/cp2-typed-tools.js",
    "cp3": "cd fixture && pi -e ../dist/cp2-typed-tools.js -e ../dist/cp3-profiles.js",
    "registry:check": "pnpm build && node dist/registry-cli.js check && node dist/registry-cli.js docs --check",
    "registry:docs": "pnpm build && node dist/registry-cli.js docs --write",
    "regulator": "node dist/cli.js",
    "cp5": "cd fixture && pi -e ../dist/cp2-typed-tools.js -e ../dist/cp3-profiles.js -e ../dist/cp4-coordination.js -e ../dist/cp5-contract.js",
    "cp6": "cd fixture && pi -e ../dist/cp2-typed-tools.js -e ../dist/cp3-profiles.js -e ../dist/cp4-coordination.js -e ../dist/cp5-contract.js -e ../dist/cp6-budget.js",
    "cp7": "cd fixture && pi -e ../dist/cp2-typed-tools.js -e ../dist/cp3-profiles.js -e ../dist/cp4-coordination.js -e ../dist/cp5-contract.js -e ../dist/cp6-budget.js -e ../dist/cp7-recovery.js",
    "cp8": "cd fixture && pi -e ../dist/cp2-typed-tools.js -e ../dist/cp3-profiles.js -e ../dist/cp4-coordination.js -e ../dist/cp5-contract.js -e ../dist/cp6-budget.js -e ../dist/cp7-recovery.js -e ../dist/cp8-evidence.js",
    "cp9": "cd fixture && pi -e ../dist/cp2-typed-tools.js -e ../dist/cp3-profiles.js -e ../dist/cp4-coordination.js -e ../dist/cp5-contract.js -e ../dist/cp6-budget.js -e ../dist/cp7-recovery.js -e ../dist/cp8-evidence.js -e ../dist/cp9-authority.js",
    "cp10": "cd fixture && pi -e ../dist/cp2-typed-tools.js -e ../dist/cp3-profiles.js -e ../dist/cp4-coordination.js -e ../dist/cp5-contract.js -e ../dist/cp6-budget.js -e ../dist/cp7-recovery.js -e ../dist/cp8-evidence.js -e ../dist/cp9-authority.js -e ../dist/cp10-intelligence.js",
    "cp11": "cd fixture && pi -e ../dist/cp2-typed-tools.js -e ../dist/cp3-profiles.js -e ../dist/cp4-coordination.js -e ../dist/cp5-contract.js -e ../dist/cp6-budget.js -e ../dist/cp7-recovery.js -e ../dist/cp8-evidence.js -e ../dist/cp9-authority.js -e ../dist/cp10-intelligence.js -e ../dist/cp11-identity.js",
    "cp12": "cd fixture && pi -e ../dist/cp2-typed-tools.js -e ../dist/cp3-profiles.js -e ../dist/cp4-coordination.js -e ../dist/cp5-contract.js -e ../dist/cp6-budget.js -e ../dist/cp7-recovery.js -e ../dist/cp8-evidence.js -e ../dist/cp9-authority.js -e ../dist/cp10-intelligence.js -e ../dist/cp11-identity.js -e ../dist/cp12-algedonic.js",
    "fixture:injection:test": "cd fixture-injection && node --test",
    "fixture:oscillation:test": "cd fixture-oscillation && node --test"
  },
  "dependencies": {
    "@metacoding/vsm-pi-checks": "workspace:*",
    "@metacoding/vsm-pi-core": "workspace:*",
    "@metacoding/vsm-pi-protocol": "workspace:*",
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
