{
  "name": "@metacoding.io/regulator-pi",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "private": false,
  "description": "The Pi host for regulator: the session-side extensions that enforce the control plane inside a Pi session (typed tools, capability profiles, coordination, the work contract, budgets, recovery, evidence, authority, intelligence, identity, the algedonic path), the dispatcher that runs a unit's session through the Pi SDK, and the generic write gate and typed reporting tools. Installable with `pi install`.",
  "keywords": [
    "pi",
    "pi-extension",
    "agent",
    "agent-harness",
    "regulator"
  ],
  "homepage": "https://github.com/MetaCoding-io/regulator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MetaCoding-io/regulator.git",
    "directory": "packages/regulator-pi"
  },
  "bugs": "https://github.com/MetaCoding-io/regulator/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "pi": {
    "extensions": [
      "./dist/tools.js",
      "./dist/profiles.js",
      "./dist/coordination.js",
      "./dist/contract.js",
      "./dist/budget.js",
      "./dist/recovery.js",
      "./dist/evidence.js",
      "./dist/authority.js",
      "./dist/intelligence.js",
      "./dist/identity.js",
      "./dist/algedonic.js"
    ]
  },
  "files": [
    "dist",
    "!dist/*.test.*",
    "!dist/test-support.*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@metacoding.io/regulator": "workspace:*",
    "@metacoding.io/regulator-checks": "workspace:*",
    "@metacoding.io/regulator-core": "workspace:*",
    "@metacoding.io/regulator-protocol": "workspace:*",
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
