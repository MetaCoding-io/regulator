{
  "name": "@metacoding/vsm-pi-extension",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@metacoding/vsm-pi-core": "workspace:*",
    "@metacoding/vsm-pi-protocol": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
