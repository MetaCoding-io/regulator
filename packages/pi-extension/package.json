{
  "name": "@metacoding/vsm-pi-extension",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": false,
  "homepage": "https://github.com/MetaCoding-io/vsm-pi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MetaCoding-io/vsm-pi.git",
    "directory": "packages/pi-extension"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@metacoding/vsm-pi-core": "workspace:*",
    "@metacoding/vsm-pi-protocol": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
