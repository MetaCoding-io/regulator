    "cp11": "cd ../../packages/regulator/fixture && pi -e ../../packages/regulator-pi/dist/tools.js -e ../../packages/regulator-pi/dist/profiles.js -e ../../packages/regulator-pi/dist/coordination.js -e ../../packages/regulator-pi/dist/contract.js -e ../../packages/regulator-pi/dist/budget.js -e ../../packages/regulator-pi/dist/recovery.js -e ../../packages/regulator-pi/dist/evidence.js -e ../../packages/regulator-pi/dist/authority.js -e ../../packages/regulator-pi/dist/intelligence.js -e ../../packages/regulator-pi/dist/identity.js",
