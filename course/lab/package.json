    "cp1": "cd ../../packages/regulator/fixture && pi -e ../../../course/lab/dist/cp1-trace.js",
    "cp2": "cd ../../packages/regulator/fixture && pi -e ../../packages/regulator-pi/dist/tools.js",
    "cp3": "cd ../../packages/regulator/fixture && pi -e ../../packages/regulator-pi/dist/tools.js -e ../../packages/regulator-pi/dist/profiles.js",
